  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Container apps running",
      "description": "Container Apps with at least one replica: the app's instances, Prometheus and Grafana.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(max by (resourceID) (azure_containerapp{metric=\"Replicas\", aggregation=\"maximum\"}) > 0)",
          "legendFormat": "",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Replica restarts",
      "description": "Restarts of the current replicas since they were created (a crash or a failed liveness probe each).",
