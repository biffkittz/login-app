<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LoginApp.Api</RootNamespace>
    <AssemblyName>LoginApp.Api</AssemblyName>
    <!-- Lets developers keep a persistent JWT signing key out of source control (docs/DEVELOPMENT.md). -->
    <UserSecretsId>ef90eba0-41c9-4ffa-a214-7d4c059ed7e8</UserSecretsId>
    <!-- XML docs feed IntelliSense and the OpenAPI document at build time; the running app never reads them. -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="Temporalio" />
    <PackageReference Include="Temporalio.Extensions.DiagnosticSource" />
    <!--
      Needed only by the `dotnet ef` tooling at design time. Publish="false" keeps it (and the Roslyn
      compiler it depends on) out of the published app and therefore out of the container image.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" Publish="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cloudflare's Authenticated Origin Pulls CA, the only issuer trusted for client certificates (Infrastructure/Tls). -->
    <EmbeddedResource Include="Infrastructure/Tls/cloudflare-origin-pull-ca.pem" LogicalName="LoginApp.Api.Infrastructure.Tls.cloudflare-origin-pull-ca.pem" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LoginApp.Api.Tests" />
  </ItemGroup>

</Project>
