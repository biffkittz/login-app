# EF Core migrations are generated by `dotnet ef`, so analyzers treat them as generated code rather than holding them
# to the rules for hand-written code. (CA1861, for one, flags the column arrays EF writes for composite indexes.)
#
# This file sits beside the migrations rather than in the repository's root .editorconfig because the Docker build
# context is app/: the root file isn't in the image, and the Release build in the Dockerfile would otherwise fail on
# rules that local builds skip.

[*.cs]
generated_code = true
dotnet_diagnostic.CS1591.severity = none
