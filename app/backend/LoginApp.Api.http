# Exercise the API against a locally running backend (`dotnet run` or the "Backend" launch configuration).
# Works with the VS Code REST Client extension (humao.rest-client) and Visual Studio.
#
# The auth token travels in an HttpOnly cookie that REST Client stores and re-sends automatically, so run the
# requests from top to bottom: register -> me -> logout -> login -> the grocery list.

@baseUrl = http://localhost:5082

### Register a new account (also signs it in by setting the auth cookie)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "displayName": "Ada Lovelace",
  "email": "ada@example.com",
  "password": "analytical engine notes"
}

### Who is signed in?
GET {{baseUrl}}/api/auth/me

### Sign out (deletes the auth cookie)
POST {{baseUrl}}/api/auth/logout

### Sign in again
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "ada@example.com",
  "password": "analytical engine notes"
}

### The shared grocery list (needs a signed-in session: run "Sign in again" first)
GET {{baseUrl}}/api/grocery-list

### Add an item at the top. The id is optional; the SPA sends one it generated, so it can show the item at once.
# @name addItem
POST {{baseUrl}}/api/grocery-list/items
Content-Type: application/json

{
  "id": "{{$guid}}",
  "name": "Milk",
  "quantity": "2 gallons",
  "brand": "Organic Valley",
  "store": "Costco",
  "notes": "The lactose-free one"
}

### Change only the quantity. Fields left out keep their value; "" clears an optional field.
PATCH {{baseUrl}}/api/grocery-list/items/{{addItem.response.body.$.savedItems[0].id}}
Content-Type: application/json

{
  "quantity": "1 gallon",
  "brand": ""
}

### Move it to the top ("afterItemId": null), or directly after another item
POST {{baseUrl}}/api/grocery-list/items/{{addItem.response.body.$.savedItems[0].id}}/move
Content-Type: application/json

{
  "afterItemId": null
}

### Remove it
DELETE {{baseUrl}}/api/grocery-list/items/{{addItem.response.body.$.savedItems[0].id}}

### An item's AI picture, once drawn: the imageUrl of an item in GET /api/grocery-list (WebP, cacheable for a year)
GET {{baseUrl}}/api/grocery-list/images/00000000-0000-0000-0000-000000000000

### Turn AI pictures off (or on) for everyone
PATCH {{baseUrl}}/api/grocery-list/settings
Content-Type: application/json

{
  "imageGenerationEnabled": false
}

### Estimate what the whole list costs at average U.S. prices (asks Gemini; counts against the daily allowance)
POST {{baseUrl}}/api/grocery-list/cost-estimate

### Liveness probe (no dependencies)
GET {{baseUrl}}/health/live

### Readiness probe (checks the database)
GET {{baseUrl}}/health/ready
